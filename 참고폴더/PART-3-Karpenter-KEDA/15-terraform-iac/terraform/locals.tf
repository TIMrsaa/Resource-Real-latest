# =============================================================================
# locals.tf — Terraform "local" 변수 (모듈 내부에서만 쓰는 값)
# =============================================================================
# variable vs local:
#   • variable : 외부 입력 (CLI, tfvars). 사용자가 바꿀 수 있음
#   • local    : 모듈 내부 계산 결과. 외부에서 못 바꿈
#
# 사용 예: local.azs (다른 .tf 파일에서 참조 가능)
# =============================================================================

locals {
  # AWS AZ 목록 자동 생성: ["ap-northeast-2a", "2b", "2c"]
  # var.region = "ap-northeast-2" 면 위처럼 풀림
  azs = ["${var.region}a", "${var.region}b", "${var.region}c"]
}
